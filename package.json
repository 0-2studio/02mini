{
  "name": "02mini",
  "version": "1.0.0",
  "description": "02 - Self-Aware AI System",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node",
    "clean": "bun -e \"await import('fs/promises').then(fs => fs.rm('dist', { recursive: true, force: true }))\"",
    "smoke": "bun scripts/smoke.ts",
    "smoke:kukechat": "bun scripts/kukechat-smoke.ts",
    "memory:health": "bun scripts/memory-health.ts",
    "memory:health:json": "bun scripts/memory-health.ts --json",
    "memory:health:test": "bun scripts/memory-health.test.ts"
  },
  "keywords": ["ai", "mcp", "self-aware", "agent"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.18.2",
    "fastify": "^5.7.4",
    "js-tiktoken": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "bun-types": "latest"
  }
}
