# AI Configuration - OpenAI Format
# Copy this file to .env and fill in your values

# API Base URL (OpenAI compatible)
AI_BASE_URL=https://api.openai.com/v1

# API Key
AI_API_KEY=your-api-key-here

# Model name
AI_MODEL=gpt-4o-mini

# Optional: Temperature (0-2)
AI_TEMPERATURE=0.7

# Optional: Max tokens
AI_MAX_TOKENS=4096

# Gateway Configuration
GATEWAY_PORT=3000
GATEWAY_HOST=127.0.0.1
GATEWAY_TOKEN=

# Autonomous Configuration
AUTONOMOUS_ENABLED=false
HEARTBEAT_INTERVAL=5
AUTONOMOUS_MIN_INTERVAL=1
AUTONOMOUS_MAX_INTERVAL=30
AUTONOMY_LEVEL=assist

# QQ / NapCat Configuration
QQ_ENABLED=false
QQ_TOKEN=
QQ_MODE=websocket-server
QQ_PORT=6099

# KukeChat Bot Configuration
KUKECHAT_ENABLED=false
KUKECHAT_BOT_KEY=your-kukechat-bot-key
KUKECHAT_BASE_URL=https://chat-api.kuke.ink/api/v1
KUKECHAT_WS_URL=wss://chat-api.kuke.ink/bot/ws
