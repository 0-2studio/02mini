{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@latest", "."]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "mcp-fetch-server@1.1.2"],
      "env": {
        "DEFAULT_LIMIT": "50000"
      }
    },
    "mcp-server-code-runner": {
      "command": "npx",
      "args": [
        "-y",
        "@iflow-mcp/mcp-server-code-runner@latest"
      ],
      "values": {}
    }
  }
}
