{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@latest", "."]
    },
    "fetch": {
      "command": "bun",
      "args": ["src/mcp-servers/fetch.ts"],
      "env": {
        "DEFAULT_LIMIT": "50000",
        "FETCH_PROXY": "http://127.0.0.1:7897"
      }
    },
    "mcp-server-code-runner": {
      "command": "npx",
      "args": [
        "-y",
        "@iflow-mcp/mcp-server-code-runner@latest"
      ],
      "values": {}
    }
  }
}
